type UserProfile {
    id: ID!
    username: String!
    email: String!
    firstName: String
    lastName: String
    bio: String
    role: String!
    status: String!
    emailVerified: Boolean!
    createdAt: String!
}

type Category {
    id: ID!
    name: String!
    description: String
    iconUrl: String
    parentCategoryId: ID
    displayOrder: Int
}

type HistoricalEvent {
    id: ID!
    title: String!
    summary: String
    detailedContent: String
    eventDate: String
    eventYear: Int
    era: String
    location: String
    latitude: Float
    longitude: Float
    wikipediaUrl: String
    imageUrl: String
    thumbnailUrl: String
    source: String!
    viewCount: Int
    likeCount: Int
    commentCount: Int
    shareCount: Int
    isTrending: Boolean
    isFeatured: Boolean
    categories: [String]
}

type Comment {
    id: ID!
    content: String!
    userId: ID!
    username: String!
    eventId: ID!
    parentCommentId: ID
    likeCount: Int
    isEdited: Boolean!
    isDeleted: Boolean!
    createdAt: String!
    updatedAt: String!
}

type FeedResponse {
    events: [HistoricalEvent]!
    pageNumber: Int!
    pageSize: Int!
    hasNext: Boolean!
    totalElements: Int!
}

type Query {
    event(id: ID!): HistoricalEvent
    events(query: String!, page: Int = 0, size: Int = 10): [HistoricalEvent]
    eventsByCategory(categoryId: ID!, page: Int = 0, size: Int = 10): [HistoricalEvent]
    feed(page: Int = 0, size: Int = 10): FeedResponse
    me: UserProfile
    categories: [Category]
}

type Mutation {
    recordInteraction(eventId: ID!, type: String!): Boolean
    addComment(eventId: ID!, content: String!, parentCommentId: ID): Comment
    toggleBookmark(eventId: ID!): Boolean
    toggleFollowCategory(categoryId: ID!): Boolean
}
