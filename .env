# ============================================================
# WIK History Feed — Environment Variables
# ============================================================

# --- PostgreSQL ---
DB_NAME=wik_history
DB_USERNAME=wikuser
DB_PASSWORD=wikpassword
DB_HOST=localhost
DB_PORT=5433

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# --- JWT (CHANGE IN PRODUCTION — must be ≥256-bit / 32+ chars) ---
JWT_SECRET=change-me-to-a-secure-256-bit-secret-key-in-prod

# --- Mail (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- pgAdmin (only used with --profile tools) ---
PGADMIN_EMAIL=admin@wik.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
